{
  "version": 7,
  "cmakeMinimumRequired": {
    "major": 3
  },
  "configurePresets": [
    {
      "name": "debug-env",
      "displayName": "debug-env",
      "hidden": true,
      "environment": {
        "ARMGCC_DIR": "$env{TOOLCHAIN_PATH}",
        "SdkRootDirPath": "$env{MCUXPRESSO_SDK_PATH}",
        "PATH": "$env{MCUX_VENV_PATH}${pathListSep}$penv{PATH}",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "MCUX_VENV_PATH": "$env{USERPROFILE}/.mcuxpressotools/.mcux-venv-3.12/bin",
        "POSTPROCESS_UTILITY": "$env{USERPROFILE}/.mcuxpressotools/mcux-fixelf-14.2.2/mcux-fixelf"
      },
      "cacheVariables": {}
    },
    {
      "name": "release-env",
      "displayName": "release-env",
      "hidden": true,
      "environment": {
        "ARMGCC_DIR": "$env{TOOLCHAIN_PATH}",
        "SdkRootDirPath": "$env{MCUXPRESSO_SDK_PATH}",
        "PATH": "$env{MCUX_VENV_PATH}${pathListSep}$penv{PATH}",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "MCUX_VENV_PATH": "$env{USERPROFILE}/.mcuxpressotools/.mcux-venv-3.12/bin",
        "POSTPROCESS_UTILITY": "$env{USERPROFILE}/.mcuxpressotools/mcux-fixelf-14.2.2/mcux-fixelf"
      },
      "cacheVariables": {}
    }
  ],
  "buildPresets": []
}